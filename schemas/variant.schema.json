{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/variant.schema.json",
  "title": "Variant",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "template": { "type": "string" },
    "title": { "type": "string" },
    "include_sections": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "personal",
          "education",
          "experience",
          "skills",
          "projects",
          "publications",
          "certifications"
        ]
      }
    },
    "tags_filter": { "type": "array", "items": { "type": "string" } }
  }
}
